{
    "server": {
        "host": "0.0.0.0",
        "port": 8081
    },
    "database": {
        "uri": "mongodb://mongo:27017",
        "database": "grxm_iam"
    },
    "keystore": {
        "host": "redis",
        "port": 6379,
        "password": "",
        "db": 0
    },
    "authority": {
        "password": "docker-compose-secure-password-123",
        "path": "/iam/api/v1/authority"
    },
    "default_role": "user",
    "id": {
        "type": "uid",
        "length": 32,
        "charset": "ABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890"
    },
    "token": {
        "type": "jwt",
        "bits": 2048,
        "algorithm": "RS256",
        "key_path": "/app/keys/newest",
        "expiration_hours": 24,
        "refresh_max_hours": 168,
        "cookie_name": "grxm_token"
    },
    "email": {
        "username_min_length": 3,
        "username_max_length": 50,
        "username_charlist": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890.-_",
        "domain_min_length": 4,
        "domain_max_length": 50,
        "domain_charlist": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890.-_",
        "domain_whitelist": [],
        "domain_blacklist": []
    },
    "password": {},
    "sms": {},
    "auth_methods": {
        "email-password": { "verify": false }
    }
}